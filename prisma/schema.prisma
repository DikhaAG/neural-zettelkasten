datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Note {
  id            String   @id
  title         String
  content       String   @db.Text
  tags          String[]
  cluster       String
  explicitLinks String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SynapticCache {
  id         String   @id @default(cuid())
  sourceId   String
  targetId   String
  similarity Float
  reason     String?
  createdAt  DateTime @default(now())

  @@unique([sourceId, targetId])
}
